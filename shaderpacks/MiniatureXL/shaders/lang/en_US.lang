option.ENCHANT_GLOW=Enchant glint glow §e[?]
option.ENCHANT_GLOW.comment=How strongly the enchantment glint on items and armor glows, following the glint texture itself (a custom purple glint from a resource pack glows purple). 0 = off
screen.GLOW_BLOCKS_SCREEN=Glow per block
screen.GLOW_BLOCKS_SCREEN.comment=Glow strength of each group of glowing blocks and mobs. 0 turns that group's glow off; the blocks still light up and still cast colored light
option.GLOW_FLAMES=Torches & lanterns
option.GLOW_FLAMES.comment=Also candles, lit furnaces, copper torches and lanterns
option.GLOW_SOUL=Soul fire
option.GLOW_LAVA=Lava, magma, fire
option.GLOW_REDSTONE=Redstone
option.GLOW_REDSTONE.comment=Redstone torches, lit redstone ore, powered dust, redstone block, powered components
option.GLOW_LAMPS=Glowstone, lamps
option.GLOW_LAMPS.comment=Glowstone, redstone lamp, shroomlight, beacon core and beacon beam
option.GLOW_SEA=Sea lanterns
option.GLOW_SEA.comment=Sea lantern, sea pickle, conduit
option.GLOW_FROGLIGHTS=Froglights
option.GLOW_AMETHYST=Amethyst
option.GLOW_END_ROD=End rods
option.GLOW_PORTALS=Portals & obsidian
option.GLOW_PORTALS.comment=Nether portal, crying obsidian, respawn anchor, end portal frame, ender chest
option.GLOW_SCULK=Sculk
option.GLOW_STEMS=Nether stems
option.GLOW_STEMS.comment=Warped and crimson stems and hyphae
option.GLOW_CONTRAST=Glow contrast
option.GLOW_CONTRAST.comment=Lightness-ranked glow (copper bulbs, lamps, fire, amethyst, crying obsidian...): the lightest texels glow 100%, darker ones less by their lightness. Higher = more contrast
option.NETHER_VEIN_BASE=Nether vein glow
option.NETHER_VEIN_BASE.comment=Warped and crimson stems: glow of the plain veins relative to the lighter animated pulse (100%). The bark never glows
option.PORTAL_OPACITY=Portal opacity
option.PORTAL_OPACITY.comment=Nether portal opacity. Like Photon, its dark body is see-through and its bright swirl opaque; 1.0 = Photon-like, lower = more see-through overall
option.SCULK_CRYSTAL_IDLE=Calibrated sensor crystal at rest
option.SCULK_CRYSTAL_IDLE.comment=Glow of the calibrated sculk sensor's amethyst crystal while idle. It glows 100% while the sensor fires, then fades through its cooldown
option.GLOW_INK_TEXT=Glow ink text
option.GLOW_INK_TEXT.comment=Light glow on sign text written with a glow ink sac. Kept low so the text stays readable. 0 = off
option.GLOW_PLANTS=Glowing plants
option.GLOW_PLANTS.comment=Open eyeblossom, glow berries, glow lichen, nether fungi, torchflower, chorus
option.GLOW_BREWING=Brewing stand
option.GLOW_MISC=Spawners & hearts
option.GLOW_MISC.comment=Spawners and the awake creaking heart
option.GLOW_OTHER=Other light sources
option.GLOW_OTHER.comment=Light-emitting blocks without a group of their own: copper bulbs, crafters, modded lights...
option.GLOW_MOBS=Glowing mobs
option.GLOW_MOBS.comment=Allay, vex, glow squid, blaze, magma cube, mob eyes (spider, enderman, phantom...), warden and creaking emissive layers, resource pack emissive textures
