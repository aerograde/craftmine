option.SUN_SHAFTS.comment=Crepuscular rays around the sun (Overworld); blocked by terrain and clouds
option.SUN_SHAFTS_STRENGTH=Sun shafts strength
option.END_STARS_SPEED=End stars speed
option.END_STARS_AMOUNT=End stars amount
